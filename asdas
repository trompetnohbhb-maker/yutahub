local function getWeatherProperty()
    local ok, p = pcall(function()
        local N = require(RS:WaitForChild("Packages"):WaitForChild("Network"))
        return N.ClientComm.new(RS.Network, false, "WeatherService"):GetProperty("ActiveWeather")
    end)
    if ok and p then return p end
    return nil
end

local function getWeather()
    local p = getWeatherProperty()
    if p then
        local ok, c = pcall(function() return p:Get() end)
        if ok and c and c.name then
            return { name = c.name, startedAt = c.startedAt, endsAt = c.endsAt }
        end
    end
    local sd = RS:FindFirstChild("ServerData")
    if sd then
        local raw = sd:GetAttribute("WeatherSnapshotV2") or sd:GetAttribute("ActiveWeathers")
        if type(raw) == "string" and raw ~= "" then
            local ok, d = pcall(function() return HS:JSONDecode(raw) end)
            if ok and type(d) == "table" then
                local w = d.Weathers or d
                if type(w) == "table" then
                    for _, entry in pairs(w) do
                        if type(entry) == "table" and entry.Type then
                            return { name = entry.Variant or entry.Type, type = entry.Type, variant = entry.Variant }
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function weatherMatches(weather, target)
    if not weather or not target or target == "" then return false end
    local t = target:lower()
    for _, c in ipairs({ weather.name, weather.type, weather.variant }) do
        if c and c ~= "" and tostring(c):lower():find(t, 1, true) then return true end
    end
    return false
end

local function queueReexecute()
    if SCRIPT_URL == "" then return false end
    local code = string.format("loadstring(game:HttpGet(%q))()", SCRIPT_URL)
    if queue_on_teleport then
        if pcall(function() queue_on_teleport(code) end) then return true end
    end
    if syn and syn.queue_on_teleport then
        if pcall(function() syn.queue_on_teleport(code) end) then return true end
    end
    if fluxus and fluxus.queue_on_teleport then
        if pcall(function() fluxus.queue_on_teleport(code) end) then return true end
    end
    return false
end

local function doHop()
    State.attempts = State.attempts + 1
    State.lastHop = os.time()
    State.pendingResume = State.resumeOnLoad
    saveState(State)
    queueReexecute()
    task.wait(0.5)
    pcall(function() TS:Teleport(game.PlaceId, LP) end)
end

