end)

function updateStatus(status, current)
    StatusLabel.Text = "Status: " .. tostring(status)
        .. "\nAttempt: " .. tostring(State.attempts)
        .. "\nCurrent: " .. tostring(current or "-")
end

local function setColor(col)
    if col == "green" then
        StatusLabel.TextColor3 = Color3.fromRGB(120, 220, 140)
    elseif col == "red" then
        StatusLabel.TextColor3 = Color3.fromRGB(240, 120, 120)
    elseif col == "yellow" then
        StatusLabel.TextColor3 = Color3.fromRGB(240, 220, 120)
    else
        StatusLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
    end
end

