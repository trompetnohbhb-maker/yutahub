local function closeDropdown()
    Dropdown.Visible = false
    Dropdown.Size = UDim2.new(1, -24, 0, 0)
end

local function openDropdown()
    for _, c in ipairs(Dropdown:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    local count = 0
    for _, name in ipairs(WEATHER_LIST) do
        count = count + 1
        local item = new("TextButton", {
            Size = UDim2.new(1, -8, 0, 26),
            Position = UDim2.fromOffset(4, 4 + (count - 1) * 26),
            BackgroundColor3 = Color3.fromRGB(50, 50, 65),
            BackgroundTransparency = 0.3,
            Text = name,
            TextColor3 = Color3.fromRGB(220, 220, 240),
            TextSize = 12,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            ZIndex = 11,
        }, Dropdown)
        local pad = Instance.new("UIPadding")
        pad.PaddingLeft = UDim.new(0, 8)
        pad.Parent = item
        local cor = Instance.new("UICorner")
        cor.CornerRadius = UDim.new(0, 3)
        cor.Parent = item
        item.MouseEnter:Connect(function() item.BackgroundTransparency = 0 end)
        item.MouseLeave:Connect(function() item.BackgroundTransparency = 0.3 end)
        item.MouseButton1Click:Connect(function()
            State.targetWeather = name
            State.attempts = 0
            saveState(State)
            TargetBtn.Text = name
            closeDropdown()
            updateStatus("Idle", "-")
        end)
    end
    Dropdown.Size = UDim2.new(1, -24, 0, math.min(#WEATHER_LIST * 26 + 8, 180))
    Dropdown.CanvasSize = UDim2.new(0, 0, 0, #WEATHER_LIST * 26 + 8)
    Dropdown.Visible = true
end

TargetBtn.MouseButton1Click:Connect(function()
