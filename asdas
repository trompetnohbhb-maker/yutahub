local function stopAutoHop()
    State.autoHop = false
    State.pendingResume = false
    saveState(State)
    StartBtn.Text = "START AUTO HOP"
    StartBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 120)
    updateStatus("Stopped", "-")
    setColor("default")
end

local function startAutoHop()
    State.autoHop = true
    saveState(State)
    StartBtn.Text = "STOP"
    StartBtn.BackgroundColor3 = Color3.fromRGB(200, 80, 80)

    task.spawn(function()
        while running and State.autoHop do
            local weather = getWeather()
            local currentName = weather and weather.name or "(none)"
            if weather and weatherMatches(weather, State.targetWeather) then
                setColor("green")
                updateStatus("FOUND! " .. currentName, currentName)
                notify("Auto Hop", "Found " .. State.targetWeather .. "!")
                State.autoHop = false
                State.pendingResume = false
                saveState(State)
                StartBtn.Text = "START AUTO HOP"
                StartBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 120)
                break
            end

            setColor("yellow")
            updateStatus("Hopping...", currentName)
            task.wait(1.5)

            if not running or not State.autoHop then break end
            doHop()
            return
        end
    end)
end

StartBtn.MouseButton1Click:Connect(function()
    if State.autoHop then stopAutoHop() else startAutoHop() end
end)

task.spawn(function()
    task.wait(1.5)
    local weather = getWeather()
    local currentName = weather and weather.name or "(none)"

    if weather and weatherMatches(weather, State.targetWeather) then
        setColor("green")
        updateStatus("ALREADY HERE!", currentName)
        notify("Auto Hop", State.targetWeather .. " sudah aktif!")
        State.attempts = 0
        State.autoHop = false
        State.pendingResume = false
        saveState(State)
        return
    end

    if State.pendingResume and State.resumeOnLoad and SCRIPT_URL ~= "" then
        updateStatus("Resuming...", currentName)
        State.pendingResume = false
        saveState(State)
        task.wait(0.5)
        startAutoHop()
    else
        updateStatus("Ready", currentName)
        State.pendingResume = false
        saveState(State)
    end
end)

