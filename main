    Title = "Apply FPS Boost Once",
    Callback = function() F.applyAntiLag() end,
})

MiscLeft:AddButton({
    Title = "Destroy UI",
    Callback = function()
        State.isDestroyed = true
        F.stopAutoBuy()
        F.stopAutoBuyPickaxe()
        F.stopAutoBuyPlot()
        F.stopAutoBuyTrail()
        F.stopAutoEquipBest()
        F.stopAutoTreadmill()
        F.stopAutoFarmEgg()
        task.delay(0.2, function()
            local gui = game:GetService("CoreGui"):FindFirstChild("Chloeex")
            if gui then gui:Destroy() end
            local tbtn = game:GetService("CoreGui"):FindFirstChild("ToggleFind")
            if tbtn then tbtn:Destroy() end
            local tbtn2 = game:GetService("CoreGui"):FindFirstChild("ToggleUIButton")
            if tbtn2 then tbtn2:Destroy() end
        end)
    end,
})

--------------------------------------------------
-- CONFIG MANAGER
--------------------------------------------------
local typedConfigName = ""
local SelectedConfig = nil

ConfigLeft:AddParagraph({
    Title = "Info",
    Content = "Folder: " .. GAME_FOLDER,
})

local cfgNameInput = ConfigLeft:AddInput({
    Title = "Config Name",
    Default = "",
    Content = "Ketik nama config",
    Callback = function(v)
        typedConfigName = tostring(v or "")
    end,
})

local cfgDropdown
cfgDropdown = ConfigLeft:AddDropdown({
    Title = "Select Config",
    Options = listConfigs(),
    Multi = false,
    Default = nil,
    Callback = function(v)
        if type(v) == "string" and v ~= "" then
            SelectedConfig = v
        else
            SelectedConfig = nil
        end
    end,
})

ConfigLeft:AddButton({
    Title = "Create / Save Config",
    SubTitle = "Overwrite if exists",
    Callback = function()
        local name = typedConfigName
        if name == "" and cfgNameInput and cfgNameInput.Value then
            name = tostring(cfgNameInput.Value or "")
        end
        if name == "" then
            F.safeNotify("Ketik nama config dulu", "Yuta Hub", 2)
            return
        end
        CurrentConfigName = name
        SaveConfig()
        cfgDropdown:SetValues(listConfigs())
        F.safeNotify("Saved: " .. name, "Yuta Hub", 2)
    end,
    SubCallback = function()
        local name = typedConfigName
        if name == "" and cfgNameInput and cfgNameInput.Value then
            name = tostring(cfgNameInput.Value or "")
        end
        if name == "" then
            F.safeNotify("Ketik nama config dulu", "Yuta Hub", 2)
            return
        end
        CurrentConfigName = name
        SaveConfig()
        cfgDropdown:SetValues(listConfigs())
        F.safeNotify("Saved: " .. name, "Yuta Hub", 2)
    end,
})

ConfigLeft:AddButton({
    Title = "Load Config",
    Callback = function()
        if not SelectedConfig or SelectedConfig == "" then
            F.safeNotify("Pilih config dulu", "Yuta Hub", 2)
            return
        end
        CurrentConfigName = SelectedConfig
        LoadConfigFromFile()
        for key, element in pairs(Elements) do
            if ConfigData[key] ~= nil and element.Set then
                pcall(function() element:Set(ConfigData[key]) end)
            end
        end
        F.safeNotify("Loaded: " .. SelectedConfig, "Yuta Hub", 2)
    end,
})

ConfigLeft:AddButton({
    Title = "Delete Config",
    Callback = function()
        if not SelectedConfig or SelectedConfig == "" then
            F.safeNotify("Pilih config dulu", "Yuta Hub", 2)
            return
        end
        local path = getConfigPath(SelectedConfig)
        if isfile and isfile(path) then
            pcall(delfile, path)
        end
        F.safeNotify("Deleted: " .. SelectedConfig, "Yuta Hub", 2)
        SelectedConfig = nil
        cfgDropdown:SetValues(listConfigs())
    end,
})

ConfigLeft:AddButton({
    Title = "Refresh Config List",
    Callback = function()
        cfgDropdown:SetValues(listConfigs())
        F.safeNotify("Refreshed", "Yuta Hub", 2)
    end,
})

ConfigLeft:AddParagraph({
    Title = "Auto Load",
    Content = "Config aktif: " .. tostring(CurrentConfigName),
})
