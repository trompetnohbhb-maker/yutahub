local THEME = {
    Accent = Color3.fromRGB(0, 140, 255),
    Dark = Color3.fromRGB(12, 12, 16),
    Panel = Color3.fromRGB(18, 18, 24),
    Text = Color3.fromRGB(230, 230, 235),
}

local Window = Chloex:Window({
    Title = "Yuta Hub",
    Footer = "Break and Steal An Egg",
    Color = THEME.Accent,
    ["Tab Width"] = 120,
    Version = 3,
    Image = "79656048822194",
})

task.defer(function()
    local gui = game:GetService("CoreGui"):FindFirstChild("Chloeex")
    if not gui then return end
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("TextButton") or d:IsA("Frame") or d:IsA("ScrollingFrame") then
            local n = string.lower(d.Name)
            if n:find("select") or n:find("option") or n:find("dropdown") or n:find("scrollselect") then
                if d.BackgroundTransparency < 0.99 then
                    pcall(function()
                        d.BackgroundColor3 = THEME.Dark
                    end)
                end
            end
        end
        if d:IsA("TextLabel") and d.Name == "OptionText" then
            pcall(function() d.TextColor3 = THEME.Text end)
        end
        if d:IsA("UIStroke") then
            pcall(function() d.Color = THEME.Accent end)
        end
    end
    local function makeExitConfirm()
        local existing = gui:FindFirstChild("ExitConfirm")
        if existing then existing:Destroy() end
        local overlay = Instance.new("Frame")
        overlay.Name = "ExitConfirm"
        overlay.Size = UDim2.fromScale(1, 1)
        overlay.BackgroundColor3 = Color3.new(0, 0, 0)
        overlay.BackgroundTransparency = 0.45
        overlay.ZIndex = 100
        overlay.Parent = gui
        local box = Instance.new("Frame")
        box.Size = UDim2.new(0, 280, 0, 120)
        box.Position = UDim2.new(0.5, -140, 0.5, -60)
        box.BackgroundColor3 = THEME.Dark
        box.BorderSizePixel = 0
        box.ZIndex = 101
        box.Parent = overlay
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
        local stroke = Instance.new("UIStroke", box)
        stroke.Color = THEME.Accent
        stroke.Thickness = 1.2
        local title = Instance.new("TextLabel")
        title.BackgroundTransparency = 1
        title.Size = UDim2.new(1, -20, 0, 50)
        title.Position = UDim2.new(0, 10, 0, 10)
        title.Font = Enum.Font.GothamBold
        title.TextSize = 14
        title.TextColor3 = THEME.Text
        title.TextWrapped = true
        title.Text = "Kamu yakin mau keluar?"
        title.ZIndex = 102
        title.Parent = box
        local function btn(text, x, cb)
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(0, 100, 0, 30)
            b.Position = UDim2.new(0, x, 1, -42)
            b.BackgroundColor3 = THEME.Panel
            b.Text = text
            b.Font = Enum.Font.GothamBold
            b.TextSize = 13
            b.TextColor3 = THEME.Text
            b.ZIndex = 102
            b.Parent = box
            Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
            b.MouseButton1Click:Connect(cb)
            return b
        end
        btn("Yes", 30, function()
            State.isDestroyed = true
            F.stopAutoBuy()
            F.stopAutoBuyPickaxe()
            F.stopAutoBuyPlot()
            F.stopAutoBuyTrail()
            F.stopAutoEquipBest()
            F.stopAutoTreadmill()
            F.stopAutoFarmEgg()
            gui:Destroy()
            local btn2 = game:GetService("CoreGui"):FindFirstChild("ToggleUIButton")
            if btn2 then btn2:Destroy() end
        end)
        btn("No", 150, function()
            overlay:Destroy()
        end)
    end
    for _, d in ipairs(gui:GetDescendants()) do
        if d:IsA("TextButton") and (d.Name == "Close" or d.Name == "close") then
            d.MouseButton1Click:Connect(function()
                task.defer(makeExitConfirm)
            end)
        end
    end
end)

