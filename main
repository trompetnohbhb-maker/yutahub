    Title = "Zone Filter",
    Options = CFG.ZoneNames,
    Multi = false,
    Default = nil,
    Callback = function(s)
        State.zoneFilter = {}
        local name = nil
        if type(s) == "string" and s ~= "" then
            name = s
        elseif type(s) == "table" then
            for k, v in pairs(s) do
                if v == true then name = k break end
                if type(v) == "string" and v ~= "" then name = v break end
            end
        end
        if name then
            State.zoneFilter[name] = true
        end
    end,
})

