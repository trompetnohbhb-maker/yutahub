-- Yuta Hub | Break and Steal An Egg
-- Egg: CollectionService tag "BreakableEgg" + attribute Health/Broken/Hatching/Despawning

for _, obj in getgc(true) do
    if typeof(obj) ~= "table" or getrawmetatable(obj) then continue end
    local mainrun = false
    for _, v in obj do
        if v == obj then
            mainrun = true
            break
        end
    end
    if not mainrun then continue end
    for _, v in obj do
        if typeof(v) == "number" and v >= 1 and v <= 3 and obj[v] == nil then
            setmetatable(obj, { __newindex = function() end })
            break
        end
    end
end

local Chloex = loadstring(game:HttpGet("https://raw.githubusercontent.com/TesterX14/XXXX/refs/heads/main/Library"))()

local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")

local _gameName = tostring(MarketplaceService:GetProductInfo(game.PlaceId).Name)
_gameName = _gameName:gsub("[^%w_ ]", ""):gsub("%s+", "_")
if _gameName == "" then _gameName = "Unknown" end

local ROOT_FOLDER = "YutaHub"
local GAME_FOLDER = ROOT_FOLDER .. "/" .. _gameName

if isfolder and not isfolder(ROOT_FOLDER) then makefolder(ROOT_FOLDER) end
if isfolder and not isfolder(GAME_FOLDER) then makefolder(GAME_FOLDER) end

local CurrentConfigName = "default"

local function getConfigPath(name)
    return GAME_FOLDER .. "/" .. tostring(name) .. ".json"
end

local function listConfigs()
    local out = {}
    if listfiles and isfolder(GAME_FOLDER) then
        local ok, files = pcall(listfiles, GAME_FOLDER)
        if ok and files then
            for _, f in ipairs(files) do
                local name = tostring(f):match("([^/\\]+)%.json$")
                if name then table.insert(out, name) end
            end
        end
    end
    table.sort(out)
    return out
end

SaveConfig = function()
    if not writefile then return end
    if type(ConfigData) ~= "table" then ConfigData = {} end
    ConfigData._version = CURRENT_VERSION
    ConfigData._name = CurrentConfigName
    pcall(writefile, getConfigPath(CurrentConfigName), HttpService:JSONEncode(ConfigData))
end

LoadConfigFromFile = function()
    local path = getConfigPath(CurrentConfigName)
    local loaded = false
    if isfile and isfile(path) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(path))
        end)
        if success and type(result) == "table" then
            ConfigData = result
            loaded = true
        end
    end
    if not loaded then
        ConfigData = { _version = CURRENT_VERSION }
    end
end

do
    local configs = listConfigs()
    if #configs > 0 then
        local chosen = nil
        for _, c in ipairs(configs) do
            if c == "default" then chosen = c break end
        end
        if not chosen then chosen = configs[1] end
        CurrentConfigName = chosen
    end
end

