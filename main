local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local Lib = {}
Lib.__index = Lib

local T = {
    Bg = Color3.fromRGB(13,13,18),
    Side = Color3.fromRGB(18,18,26),
    Top = Color3.fromRGB(22,22,32),
    Acc = Color3.fromRGB(0,180,255),
    Elm = Color3.fromRGB(25,25,35),
    Hov = Color3.fromRGB(32,32,46),
    Txt = Color3.fromRGB(255,255,255),
    Sub = Color3.fromRGB(140,140,155),
    Brd = Color3.fromRGB(35,35,48),
    BrdH = Color3.fromRGB(55,55,75),
    Bad = Color3.fromRGB(220,50,50),
    Good = Color3.fromRGB(50,220,50),
}
local Tr = { Main=0.15, Side=0.3, Top=0.4, Elm=0.25, ElmH=0.15, TabA=0.2, TabH=0.35 }
local RC = { MinW=420, MinH=300, MaxW=1600, MaxH=900, Handle=18 }
local DefW, DefH = 900, 650

local A = {
    F = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    S = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    M = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
}

local function tw(o,i,p) local t=TweenService:Create(o,i,p) t:Play() return t end
local function corner(p,r) local c=Instance.new("UICorner") c.CornerRadius=UDim.new(0,r or 8) c.Parent=p return c end
local function stroke(p,c,t,tr) local s=Instance.new("UIStroke") s.Color=c or T.Brd s.Thickness=t or 1 s.Transparency=tr or 0.3 s.Parent=p return s end
local function txt(p,prop) local l=Instance.new("TextLabel") l.BackgroundTransparency=1 l.Font=Enum.Font.GothamBold l.TextSize=12 l.TextColor3=T.Txt l.TextXAlignment=Enum.TextXAlignment.Left l.ZIndex=5 l.Parent=p for k,v in pairs(prop) do l[k]=v end return l end
local function btn(p,prop) local b=Instance.new("TextButton") b.AutoButtonColor=false b.Text="" b.BorderSizePixel=0 b.Parent=p for k,v in pairs(prop) do b[k]=v end return b end
local function frame(p,prop) local f=Instance.new("Frame") f.BorderSizePixel=0 f.Parent=p for k,v in pairs(prop) do f[k]=v end return f end

local function drag(trg,tgt)
    local d,ds,sp=false,nil,nil
    trg.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            d=true ds=i.Position sp=tgt.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if d and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            local delta=i.Position-ds
            tgt.Position=UDim2.new(sp.X.Scale,sp.X.Offset+delta.X,sp.Y.Scale,sp.Y.Offset+delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then d=false end
    end)
end

local function resize(h,mf)
    local r,rs,ss=false,nil,nil
    h.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            r=true rs=i.Position ss=mf.Size
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if r and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            local d=i.Position-rs
            mf.Size=UDim2.new(0,math.clamp(ss.X.Offset+d.X,RC.MinW,RC.MaxW),0,math.clamp(ss.Y.Offset+d.Y,RC.MinH,RC.MaxH))
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then r=false end
    end)
end

function Lib:CreateWindow(title)
    local win={CurrentTab=nil,Tabs={},Active=true,Popup=nil,Notifications={}}
    if CoreGui:FindFirstChild("YutaHub") then CoreGui["YutaHub"]:Destroy() end
    local sg=Instance.new("ScreenGui")
    sg.Name="YutaHub" sg.ResetOnSpawn=false sg.DisplayOrder=99999 sg.Parent=CoreGui
    win.ScreenGui=sg

    local mf=frame(sg,{Name="MainFrame",Size=UDim2.new(0,DefW,0,DefH),Position=UDim2.new(0.5,-DefW/2,0.5,-DefH/2),BackgroundColor3=T.Bg,BackgroundTransparency=Tr.Main,ClipsDescendants=true,Active=true,ZIndex=0})
    win.MainFrame=mf
    corner(mf,12) stroke(mf,T.Brd,1.2,0.3)

    local tb=frame(mf,{Name="TopBar",Size=UDim2.new(1,0,0,40),BackgroundColor3=T.Top,BackgroundTransparency=Tr.Top,ZIndex=2})
    corner(tb,12) drag(tb,mf)
    txt(tb,{Name="Title",Size=UDim2.new(1,-140,1,0),Position=UDim2.new(0,16,0,0),Text=string.upper(title or "YUTA HUB"),TextSize=13,ZIndex=3})
    frame(tb,{Size=UDim2.new(1,0,0,1.5),Position=UDim2.new(0,0,1,0),BackgroundColor3=T.Acc,BackgroundTransparency=0.2,ZIndex=5})

    local cb=btn(tb,{Size=UDim2.new(0,26,0,26),Position=UDim2.new(1,-36,0.5,-13),BackgroundColor3=Color3.fromRGB(28,28,38),BackgroundTransparency=0.3,Text="×",TextColor3=T.Sub,Font=Enum.Font.GothamBold,TextSize=16,ZIndex=3})
    corner(cb,5)
    cb.MouseEnter:Connect(function() tw(cb,A.F,{BackgroundColor3=T.Bad,TextColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.1}) end)
    cb.MouseLeave:Connect(function() tw(cb,A.F,{BackgroundColor3=Color3.fromRGB(28,28,38),TextColor3=T.Sub,BackgroundTransparency=0.3}) end)
    cb.MouseButton1Click:Connect(function() sg:Destroy() win.Active=false end)

    local mb=btn(tb,{Size=UDim2.new(0,26,0,26),Position=UDim2.new(1,-68,0.5,-13),BackgroundColor3=Color3.fromRGB(28,28,38),BackgroundTransparency=0.3,Text="—",TextColor3=T.Sub,Font=Enum.Font.GothamBold,TextSize=14,ZIndex=3})
    corner(mb,5)
    mb.MouseEnter:Connect(function() tw(mb,A.F,{BackgroundColor3=Color3.fromRGB(38,38,52),TextColor3=T.Txt,BackgroundTransparency=0.1}) end)
    mb.MouseLeave:Connect(function() tw(mb,A.F,{BackgroundColor3=Color3.fromRGB(28,28,38),TextColor3=T.Sub,BackgroundTransparency=0.3}) end)

    local sb=frame(mf,{Name="Sidebar",Size=UDim2.new(0,150,1,-40),Position=UDim2.new(0,0,0,40),BackgroundColor3=T.Side,BackgroundTransparency=Tr.Side,ZIndex=2})
    local cf=frame(mf,{Name="Container",Size=UDim2.new(1,-150,1,-40),Position=UDim2.new(0,150,0,40),BackgroundTransparency=1,ClipsDescendants=true,ZIndex=2})
    win.Sidebar=sb win.ContainerFrame=cf

    local sl=Instance.new("UIListLayout") sl.Padding=UDim.new(0,4) sl.HorizontalAlignment=Enum.HorizontalAlignment.Center sl.SortOrder=Enum.SortOrder.LayoutOrder sl.Parent=sb
    local sp=Instance.new("UIPadding") sp.PaddingTop=UDim.new(0,10) sp.Parent=sb

    local rh=btn(mf,{Name="ResizeHandle",Size=UDim2.new(0,RC.Handle,0,RC.Handle),Position=UDim2.new(1,-RC.Handle-4,1,-RC.Handle-4),BackgroundColor3=T.Brd,BackgroundTransparency=0.5,Text="⋰",TextColor3=T.Sub,Font=Enum.Font.GothamBold,TextSize=14,ZIndex=999})
    corner(rh,4)
    rh.MouseEnter:Connect(function() tw(rh,A.F,{BackgroundTransparency=0.1,BackgroundColor3=T.Acc}) end)
    rh.MouseLeave:Connect(function() tw(rh,A.F,{BackgroundTransparency=0.5,BackgroundColor3=T.Brd}) end)
    resize(rh,mf)

    local mtg=btn(sg,{Name="YToggle",Size=UDim2.new(0,46,0,46),Position=UDim2.new(0,20,0,20),BackgroundColor3=T.Side,BackgroundTransparency=0.15,Text="Y",TextColor3=T.Acc,Font=Enum.Font.GothamBlack,TextSize=22,ZIndex=9999})
    corner(mtg,12) stroke(mtg,T.Brd,1.2,0.3)
    drag(mtg,mtg)

    task.spawn(function()
        while mtg and mtg.Parent do
            tw(mtg,TweenInfo.new(1,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{TextColor3=T.Txt})
            task.wait(1)
            if not (mtg and mtg.Parent) then break end
            tw(mtg,TweenInfo.new(1,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{TextColor3=T.Acc})
            task.wait(1)
        end
    end)

    mtg.MouseButton1Click:Connect(function()
        mf.Visible = not mf.Visible
        if not mf.Visible and win.Popup and win.Popup.Parent then win.Popup:Destroy() win.Popup=nil end
    end)
    mb.MouseButton1Click:Connect(function()
        mf.Visible = false
        if win.Popup and win.Popup.Parent then win.Popup:Destroy() win.Popup=nil end
    end)

    return win
end

function Lib:CreateTab(win,name)
    local tab={Window=win,Name=name}
    local tb=btn(win.Sidebar,{Name=name.."Tab",Size=UDim2.new(1,-18,0,32),BackgroundColor3=T.Elm,BackgroundTransparency=1,Text="   "..name,TextColor3=T.Sub,Font=Enum.Font.GothamBold,TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=3})
    corner(tb,7)
    tab.TabButton=tb

    local ind=frame(tb,{Name="Indicator",Size=UDim2.new(0,3,0.6,0),Position=UDim2.new(0,0,0,7),BackgroundColor3=T.Acc,BackgroundTransparency=1,ZIndex=4})

    local ps=Instance.new("ScrollingFrame")
    ps.Name=name.."Page" ps.Size=UDim2.new(1,0,1,0) ps.BackgroundTransparency=1 ps.BorderSizePixel=0 ps.ScrollBarThickness=3 ps.ScrollBarImageColor3=T.BrdH ps.Visible=false ps.ZIndex=3 ps.Parent=win.ContainerFrame
    tab.PageScroll=ps

    local pl=Instance.new("UIListLayout") pl.Padding=UDim.new(0,7) pl.HorizontalAlignment=Enum.HorizontalAlignment.Center pl.SortOrder=Enum.SortOrder.LayoutOrder pl.Parent=ps
    local pp=Instance.new("UIPadding") pp.PaddingTop=UDim.new(0,12) pp.PaddingBottom=UDim.new(0,12) pp.Parent=ps
    pl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() ps.CanvasSize=UDim2.new(0,0,0,pl.AbsoluteContentSize.Y+24) end)

    local function activate()
        if win.CurrentTab==tab then return end
        if win.CurrentTab then
            local o=win.CurrentTab
            o.PageScroll.Visible=false
            tw(o.TabButton,A.F,{BackgroundTransparency=1,TextColor3=T.Sub})
            local oi=o.TabButton:FindFirstChild("Indicator")
            if oi then tw(oi,A.F,{BackgroundTransparency=1}) end
        end
        win.CurrentTab=tab
        ps.Visible=true
        tw(tb,A.F,{BackgroundTransparency=Tr.TabA,BackgroundColor3=Color3.fromRGB(24,25,38),TextColor3=T.Acc})
        tw(ind,A.F,{BackgroundTransparency=0})
        if win.Popup and win.Popup.Parent then win.Popup:Destroy() win.Popup=nil end
    end

    tb.MouseEnter:Connect(function() if win.CurrentTab~=tab then tw(tb,A.F,{BackgroundTransparency=Tr.TabH,BackgroundColor3=Color3.fromRGB(18,19,28),TextColor3=T.Txt}) end end)
    tb.MouseLeave:Connect(function() if win.CurrentTab~=tab then tw(tb,A.F,{BackgroundTransparency=1,TextColor3=T.Sub}) end end)
    tb.MouseButton1Click:Connect(activate)
    if #win.Tabs==0 then activate() end
    table.insert(win.Tabs,tab)
    return tab
end

local function baseEl(tab,h)
    local e=btn(tab.PageScroll,{Size=UDim2.new(1,-24,0,h),BackgroundColor3=T.Elm,BackgroundTransparency=Tr.Elm,ZIndex=4})
    corner(e,7) stroke(e,T.Brd,1,0.3)
    return e
end

function Lib:CreateGroupbox(tab,title,side)
    side = side or 1
    local container = tab.PageScroll
    
    local g = frame(container,{Name=title.."GB",Size=UDim2.new(side==1 and 0.48 or 0.48,-8,0,0),BackgroundColor3=T.Elm,BackgroundTransparency=Tr.Elm,ZIndex=4})
    corner(g,7) stroke(g,T.Brd,1,0.3)
    
    local tl = txt(g,{Size=UDim2.new(1,-16,0,20),Position=UDim2.new(0,8,0,6),Text=string.upper(title),TextSize=11,TextColor3=T.Acc,Font=Enum.Font.GothamBold})
    
    local content = Instance.new("ScrollingFrame")
    content.Name="Content" content.Size=UDim2.new(1,-8,1,-32) content.Position=UDim2.new(0,4,0,28) content.BackgroundTransparency=1 content.BorderSizePixel=0 content.ScrollBarThickness=2 content.ScrollBarImageColor3=T.BrdH content.ZIndex=4 content.Parent=g
    
    local cl = Instance.new("UIListLayout") cl.Padding=UDim.new(0,4) cl.HorizontalAlignment=Enum.HorizontalAlignment.Center cl.SortOrder=Enum.SortOrder.LayoutOrder cl.Parent=content
    cl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() content.CanvasSize=UDim2.new(0,0,0,cl.AbsoluteContentSize.Y+8) end)
    
    g.LayoutOrder = side == 1 and container:FindFirstChild("Content") and 0 or 1
    
    return {Frame=g,Content=content,LayoutOrder=0}
end

function Lib:CreateSection(tab,title)
    local s=frame(tab.PageScroll,{Size=UDim2.new(1,-24,0,22),BackgroundTransparency=1,ZIndex=4})
    local l=txt(s,{Size=UDim2.new(0,0,1,0),Text=string.upper(title),TextColor3=T.Acc,TextSize=10,ZIndex=4})
    l:GetPropertyChangedSignal("TextBounds"):Connect(function()
        local bx=l.TextBounds.X
        local ln=s:FindFirstChild("Line") or frame(s,{Name="Line"})
        ln.Size=UDim2.new(1,-(bx+12),0,1)
        ln.Position=UDim2.new(0,bx+12,0.5,0)
        ln.BackgroundColor3=T.Brd
        ln.BackgroundTransparency=0.3
        ln.ZIndex=4
    end)
end

function Lib:CreateLabel(tab,text)
    local e=baseEl(tab,32)
    txt(e,{Size=UDim2.new(1,-24,1,0),Position=UDim2.new(0,12,0,0),Text=text,TextColor3=T.Sub,Font=Enum.Font.Gotham,TextSize=12})
    return e
end

function Lib:CreateButton(tab,text,cb)
    local e=baseEl(tab,38)
    txt(e,{Size=UDim2.new(1,-24,1,0),Position=UDim2.new(0,12,0,0),Text=text})
    local s=e:FindFirstChildOfClass("UIStroke")
    e.MouseEnter:Connect(function() tw(e,A.F,{BackgroundColor3=T.Hov,BackgroundTransparency=Tr.ElmH}) if s then tw(s,A.F,{Color=T.BrdH}) end end)
    e.MouseLeave:Connect(function() tw(e,A.F,{BackgroundColor3=T.Elm,BackgroundTransparency=Tr.Elm}) if s then tw(s,A.F,{Color=T.Brd}) end end)
    e.MouseButton1Click:Connect(function() task.spawn(cb or function() end) end)
    return e
end

function Lib:CreateToggle(tab,text,default,cb)
    local st=default or false
    local e=baseEl(tab,38)
    txt(e,{Size=UDim2.new(1,-70,1,0),Position=UDim2.new(0,12,0,0),Text=text})
    local sw=frame(e,{Size=UDim2.new(0,36,0,18),Position=UDim2.new(1,-48,0.5,-9),BackgroundColor3=st and T.Acc or Color3.fromRGB(45,48,58),ZIndex=5})
    corner(sw,9)
    local kn=frame(sw,{Size=UDim2.new(0,14,0,14),Position=st and UDim2.new(0,20,0.5,-7) or UDim2.new(0,2,0.5,-7),BackgroundColor3=Color3.fromRGB(255,255,255),ZIndex=6})
    corner(kn,7)
    
    local obj = {Value=st,Type="Toggle"}
    function obj:SetValue(v)
        st=v
        tw(sw,A.F,{BackgroundColor3=st and T.Acc or Color3.fromRGB(45,48,58)})
        tw(kn,A.F,{Position=st and UDim2.new(0,20,0.5,-7) or UDim2.new(0,2,0.5,-7)})
        self.Value=st
        task.spawn(cb or function() end,st)
    end
    
    e.MouseButton1Click:Connect(function()
        obj:SetValue(not st)
    end)
    
    return obj
end

function Lib:CreateSlider(tab,text,mn,mx,def,cb)
    mn=mn or 0 mx=mx or 100
    local val=math.clamp(def or mn,mn,mx)
    local e=baseEl(tab,48)
    txt(e,{Size=UDim2.new(1,-70,0,20),Position=UDim2.new(0,12,0,6),Text=text})
    local vl=txt(e,{Size=UDim2.new(0,56,0,20),Position=UDim2.new(1,-68,0,6),Text=tostring(val),TextColor3=T.Acc,TextXAlignment=Enum.TextXAlignment.Right})
    local bb=frame(e,{Size=UDim2.new(1,-24,0,5),Position=UDim2.new(0,12,1,-16),BackgroundColor3=Color3.fromRGB(35,38,48),ZIndex=5})
    corner(bb,2)
    local fl=frame(bb,{Size=UDim2.new((val-mn)/(mx-mn),0,1,0),BackgroundColor3=T.Acc,ZIndex=6})
    corner(fl,2)
    local kn=frame(bb,{Size=UDim2.new(0,11,0,11),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new((val-mn)/(mx-mn),0,0.5,0),BackgroundColor3=Color3.fromRGB(255,255,255),ZIndex=7})
    corner(kn,5)
    
    local drg=false
    local obj = {Value=val,Type="Slider"}
    
    local function upd(x)
        local r=math.clamp((x-bb.AbsolutePosition.X)/bb.AbsoluteSize.X,0,1)
        val=math.floor(mn+(mx-mn)*r+0.5)
        vl.Text=tostring(val)
        fl.Size=UDim2.new(r,0,1,0)
        kn.Position=UDim2.new(r,0,0.5,0)
        obj.Value=val
        task.spawn(cb or function() end,val)
    end
    
    bb.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drg=true upd(i.Position.X) end end)
    UserInputService.InputChanged:Connect(function(i) if drg and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then upd(i.Position.X) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drg=false end end)
    
    return obj
end

local function openPopup(win, title, opts, isMulti, sel, onSelect)
    if win.Popup and win.Popup.Parent then win.Popup:Destroy() end
    win.Popup=nil

    local mf=win.MainFrame
    local popW=220
    local margin=5

    local p=frame(mf,{Name="Popup",Size=UDim2.new(0,popW,0,500),Position=UDim2.new(1,-popW-5,0,40),BackgroundColor3=Color3.fromRGB(10,12,18),BackgroundTransparency=0,ZIndex=2000,ClipsDescendants=true})
    corner(p,9)
    local glowStroke=Instance.new("UIStroke")
    glowStroke.Color=Color3.fromRGB(0,90,140)
    glowStroke.Thickness=1.2
    glowStroke.Transparency=0.5
    glowStroke.Parent=p
    win.Popup=p

    local searchBg=frame(p,{Size=UDim2.new(1,-20,0,28),Position=UDim2.new(0,10,0,10),BackgroundColor3=Color3.fromRGB(15,18,26),ZIndex=2001})
    corner(searchBg,6)
    local sStroke=Instance.new("UIStroke")
    sStroke.Color=Color3.fromRGB(0,80,120)
    sStroke.Thickness=1
    sStroke.Transparency=0.5
    sStroke.Parent=searchBg

    local searchBox=Instance.new("TextBox")
    searchBox.Size=UDim2.new(1,-16,1,0)
    searchBox.Position=UDim2.new(0,8,0,0)
    searchBox.BackgroundTransparency=1
    searchBox.Text=""
    searchBox.PlaceholderText="Search..."
    searchBox.PlaceholderColor3=Color3.fromRGB(140,145,155)
    searchBox.TextColor3=Color3.fromRGB(255,255,255)
    searchBox.Font=Enum.Font.Gotham
    searchBox.TextSize=11
    searchBox.TextXAlignment=Enum.TextXAlignment.Left
    searchBox.ClearTextOnFocus=false
    searchBox.ZIndex=2002
    searchBox.Parent=searchBg

    local sc=Instance.new("ScrollingFrame")
    sc.Size=UDim2.new(1,-16,1,-52)
    sc.Position=UDim2.new(0,8,0,44)
    sc.BackgroundTransparency=1
    sc.BorderSizePixel=0
    sc.ScrollBarThickness=3
    sc.ScrollBarImageColor3=Color3.fromRGB(60,70,90)
    sc.CanvasSize=UDim2.new(0,0,0,#opts*26)
    sc.ZIndex=2001
    sc.Parent=p
    local ll=Instance.new("UIListLayout")
    ll.Padding=UDim.new(0,2)
    ll.SortOrder=Enum.SortOrder.LayoutOrder
    ll.Parent=sc

    local rows={}

    local function buildList(filter)
        for _,r in ipairs(rows) do r:Destroy() end
        rows={}
        local count=0
        for _,opt in ipairs(opts) do
            local optStr=tostring(opt)
            if filter=="" or string.find(string.lower(optStr),string.lower(filter),1,true) then
                count=count+1
                local row=btn(sc,{Size=UDim2.new(1,0,0,26),BackgroundColor3=Color3.fromRGB(15,18,26),BackgroundTransparency=0,Text="",ZIndex=2002})
                corner(row,5)
                local lbl=txt(row,{Size=UDim2.new(1,-38,1,0),Position=UDim2.new(0,10,0,0),Text=optStr,Font=Enum.Font.Gotham,TextColor3=Color3.fromRGB(255,255,255),TextSize=11,ZIndex=2003})
                if isMulti then
                    local ck=frame(row,{Size=UDim2.new(0,12,0,12),Position=UDim2.new(1,-20,0.5,-6),BackgroundColor3=sel[opt] and Color3.fromRGB(0,140,255) or Color3.fromRGB(30,35,45),ZIndex=2003})
                    corner(ck,3)
                end
                row.MouseEnter:Connect(function()
                    tw(row,A.F,{BackgroundColor3=Color3.fromRGB(25,30,42)})
                    lbl.TextColor3=Color3.fromRGB(0,180,255)
                end)
                row.MouseLeave:Connect(function()
                    tw(row,A.F,{BackgroundColor3=Color3.fromRGB(15,18,26)})
                    lbl.TextColor3=Color3.fromRGB(255,255,255)
                end)
                row.MouseButton1Click:Connect(function()
                    onSelect(opt,row)
                end)
                table.insert(rows,row)
            end
        end
        sc.CanvasSize=UDim2.new(0,0,0,count*28+4)
    end

    buildList("")

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        buildList(searchBox.Text)
    end)

    searchBox.Focused:Connect(function()
        sStroke.Color=Color3.fromRGB(0,140,200)
        sStroke.Transparency=0.2
    end)
    searchBox.FocusLost:Connect(function()
        sStroke.Color=Color3.fromRGB(0,80,120)
        sStroke.Transparency=0.5
    end)
end

function Lib:CreateDropdown(tab,text,opts,def,cb,multi)
    opts=opts or {}
    multi = multi or false
    local sel = multi and (def or {}) or (def or (opts[1] or "None"))
    local e=baseEl(tab,38)
    txt(e,{Size=UDim2.new(1,-110,1,0),Position=UDim2.new(0,12,0,0),Text=text})
    
    local dispText = sel
    if multi and type(sel)=="table" then
        local count=0 for _ in pairs(sel) do count=count+1 end
        dispText = count.." selected"
    end
    
    local vl=txt(e,{Size=UDim2.new(0,76,1,0),Position=UDim2.new(1,-108,0,0),Text=tostring(dispText),TextColor3=T.Acc,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Right})
    txt(e,{Size=UDim2.new(0,20,1,0),Position=UDim2.new(1,-24,0,0),Text="▼",TextColor3=T.Sub,TextSize=10})
    
    local obj = {Value=sel,Type="Dropdown",Multi=multi,Values=opts}
    
    function obj:SetValue(v)
        if multi then
            sel = v or {}
            local count=0 for _ in pairs(sel) do count=count+1 end
            vl.Text = count.." selected"
            self.Value = sel
        else
            sel = v
            vl.Text = tostring(sel)
            self.Value = sel
        end
        task.spawn(cb or function() end, self.Value)
    end
    
    function obj:SetValues(newOpts)
        self.Values = newOpts
    end

    e.MouseButton1Click:Connect(function()
        local win=tab.Window
        if win.Popup and win.Popup.Parent then win.Popup:Destroy() win.Popup=nil return end
        openPopup(win,text,opts,multi,sel,function(opt,row)
            if multi then
                sel[opt]=not sel[opt] or nil
                local ck
                for _,ch in ipairs(row:GetChildren()) do if ch:IsA("Frame") then ck=ch break end end
                if ck then ck.BackgroundColor3=sel[opt] and T.Acc or Color3.fromRGB(35,38,48) end
                local count=0 for _ in pairs(sel) do count=count+1 end
                vl.Text = count.." selected"
                local arr={} for k in pairs(sel) do table.insert(arr,k) end
                obj.Value = sel
                task.spawn(cb or function() end, sel)
            else
                sel=opt 
                vl.Text=tostring(sel)
                if win.Popup then win.Popup:Destroy() win.Popup=nil end
                obj.Value = sel
                task.spawn(cb or function() end, sel)
            end
        end)
    end)
    
    return obj
end

function Lib:CreateInput(tab,text,placeholder,cb)
    local e=baseEl(tab,38)
    txt(e,{Size=UDim2.new(1,-180,1,0),Position=UDim2.new(0,12,0,0),Text=text})
    local bb=frame(e,{Size=UDim2.new(0,150,0,24),Position=UDim2.new(1,-162,0.5,-12),BackgroundColor3=Color3.fromRGB(20,22,30),ZIndex=5})
    corner(bb,5)
    local st=stroke(bb,T.Brd,1,0.3)
    local tb=Instance.new("TextBox")
    tb.Size=UDim2.new(1,-12,1,0) tb.Position=UDim2.new(0,6,0,0) tb.BackgroundTransparency=1 tb.Text="" tb.PlaceholderText=placeholder or "..." tb.PlaceholderColor3=T.Sub tb.TextColor3=T.Txt tb.Font=Enum.Font.Gotham tb.TextSize=11 tb.TextXAlignment=Enum.TextXAlignment.Left tb.ClearTextOnFocus=false tb.ZIndex=6 tb.Parent=bb
    
    local obj = {Value="",Type="Input"}
    
    function obj:SetValue(v)
        tb.Text = tostring(v or "")
        self.Value = tb.Text
    end
    
    tb.Focused:Connect(function() tw(st,A.F,{Color=T.Acc}) end)
    tb.FocusLost:Connect(function() 
        tw(st,A.F,{Color=T.Brd}) 
        obj.Value = tb.Text
        task.spawn(cb or function() end, tb.Text) 
    end)
    
    return obj
end

function Lib:ShowNotification(title,desc,duration)
    duration = duration or 3
    local sg = CoreGui:FindFirstChild("YutaHub")
    if not sg then return end
    
    local notif = frame(sg,{Size=UDim2.new(0,300,0,80),Position=UDim2.new(1,-320,1,-100),BackgroundColor3=T.Elm,BackgroundTransparency=Tr.Elm,ZIndex=5000})
    corner(notif,8)
    stroke(notif,T.Acc,1.2,0.3)
    
    txt(notif,{Size=UDim2.new(1,-20,0,25),Position=UDim2.new(0,10,0,5),Text=title,TextColor3=T.Acc,TextSize=12,Font=Enum.Font.GothamBold})
    txt(notif,{Size=UDim2.new(1,-20,1,-35),Position=UDim2.new(0,10,0,30),Text=desc,TextColor3=T.Sub,TextSize=10,Font=Enum.Font.Gotham,TextWrapped=true})
    
    task.delay(duration,function()
        if notif and notif.Parent then
            tw(notif,A.M,{BackgroundTransparency=1})
            task.wait(0.3)
            notif:Destroy()
        end
    end)
end

return Lib
