F.getCash = function()
    local v = LP:GetAttribute("Cash")
    return type(v) == "number" and v or 0
end

F.tpToPosition = function(pos)
    local char = LP.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    pcall(function()
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    task.wait(0.04)
    return true
end

F.getMyBase = function()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, child in ipairs(plots:GetChildren()) do
        if child:GetAttribute("OwnerUserId") == LP.UserId then return child end
        for _, sub in ipairs(child:GetChildren()) do
            if sub:GetAttribute("OwnerUserId") == LP.UserId then return sub end
        end
    end
    return nil
end

F.getBasePos = function()
    local base = F.getMyBase()
    if not base then return nil end
    local hitbox = base:FindFirstChild("Hitbox")
    if hitbox and hitbox:IsA("BasePart") then return hitbox.Position end
    return base:GetPivot().Position
end

F.tpToBase = function()
    local pos = F.getBasePos()
    if not pos then return false end
    return F.tpToPosition(pos)
end

F.isAtBase = function(radius)
    radius = radius or 20
    local pos = F.getBasePos()
    if not pos then return false end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return (hrp.Position - pos).Magnitude <= radius
end

--------------------------------------------------
F.isEggLive = function(egg)
    if egg == nil or egg.Parent == nil then return false end
    if egg:GetAttribute("Broken") then return false end
    if egg:GetAttribute("Hatching") then return false end
    if egg:GetAttribute("Despawning") then return false end
    local hp = egg:GetAttribute("Health")
    if type(hp) == "number" and hp <= 0 then return false end
    return true
end

F.getEggPart = function(egg)
    if not egg then return nil end
    if egg:IsA("BasePart") then return egg end
    if egg:IsA("Model") then
        return egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

F.getEggPos = function(egg)
    local part = F.getEggPart(egg)
    return part and part.Position or nil
end

F.surfaceDistance = function(part, fromPos)
    if not part or not part:IsA("BasePart") then
        local p = F.getEggPart(part)
        if not p then return math.huge end
        part = p
    end
    local size = part.Size
    local halfXZ = math.max(size.X, size.Z) / 2
    local delta = fromPos - part.Position
    local xz = math.max(Vector3.new(delta.X, 0, delta.Z).Magnitude - halfXZ, 0)
    local y = math.max(math.abs(delta.Y) - size.Y / 2, 0)
    return math.sqrt(xz * xz + y * y)
end

F.getEggRarity = function(egg)
    if not egg then return nil end
    local r = egg:GetAttribute("Rarity") or egg:GetAttribute("rarity")
    if type(r) == "string" and r ~= "" then return r end
    for _, name in ipairs({ "Outer", "Egg" }) do
        local root = egg:FindFirstChild(name)
        if root then
            local oh = root:FindFirstChild("EggOverhead", true)
            if oh then
                local info = oh:FindFirstChild("EggInfoUi")
                if info then
                    local rar = info:FindFirstChild("Rarity")
                    if rar then
                        if rar:IsA("TextLabel") or rar:IsA("TextButton") then
                            local t = (rar.Text or ""):match("^%s*(.-)%s*$")
                            if t ~= "" then return t end
                        end
                        local lbl = rar:FindFirstChildWhichIsA("TextLabel")
                        if lbl then
                            local t = (lbl.Text or ""):match("^%s*(.-)%s*$")
                            if t ~= "" then return t end
                        end
                    end
                end
            end
        end
    end
    return nil
end

F.getEggZoneId = function(egg)
    if not egg then return nil end
    local z = egg:GetAttribute("ZoneId") or egg:GetAttribute("ZoneID") or egg:GetAttribute("Zone")
    if type(z) == "number" then return "Zone" .. tostring(z) end
    if type(z) == "string" and z ~= "" then return z end
    local p = egg.Parent
    while p and p ~= Workspace do
        local n = p.Name
        if n:match("^Zone%d") then return n:match("^Zone%d+") end
        if CFG.NameByZoneId[n] then return n end
        p = p.Parent
    end
    return nil
end

F.matchesZoneFilter = function(zoneNameOrId)
    if next(State.zoneFilter) == nil then return false end
    if zoneNameOrId == nil then return false end

    local s = tostring(zoneNameOrId):match("^%s*(.-)%s*$")
    if s == "" then return false end

    if State.zoneFilter[s] then return true end

    local name = CFG.NameByZoneId[s] or CFG.NameByZoneId[string.lower(s)]
    if name and State.zoneFilter[name] then return true end

    local num = s:match("^Zone(%d+)$") or s:match("^(%d+)$")
    if num then
        name = CFG.NameByZoneId["Zone" .. num] or CFG.NameByZoneId[num]
        if name and State.zoneFilter[name] then return true end
    end

    return false
end

F.matchesEggRarityFilter = function(rarity)
    if next(State.eggRarityFilter) == nil then return true end
    if not rarity then return false end
    local clean = tostring(rarity):match("^%s*(.-)%s*$")
    if State.eggRarityFilter[clean] then return true end
    for k, v in pairs(State.eggRarityFilter) do
        if v and string.lower(tostring(k)) == string.lower(clean) then return true end
    end
    return false
end

F.matchesRarityFilter = function(rarity)
    local minIdx = State.minRarityIdx or 1
    if not rarity then return minIdx <= 1 end
    local clean = tostring(rarity):match("^%s*(.-)%s*$")
    local idx = CFG.RarityIndex[clean] or CFG.RarityIndex[string.lower(clean)] or 1
    return idx >= minIdx
end

F.parseCashText = function(text)
    if type(text) ~= "string" then return 0 end
    text = text:gsub("%$", ""):gsub("/s", ""):gsub("%s+", ""):gsub(",", "")
    local num, suffix = text:match("^([%d%.]+)([KkMmBbTt]?)$")
    if not num then num = text:match("([%d%.]+)") end
    local n = tonumber(num)
    if not n then return 0 end
    local s = string.lower(suffix or "")
    if s == "k" then n = n * 1e3
    elseif s == "m" then n = n * 1e6
    elseif s == "b" then n = n * 1e9
    elseif s == "t" then n = n * 1e12
    end
    return n
end

F.matchesPerSecondFilter = function(value)
    local minPs = State.minPerSecond or 0
    if minPs <= 0 then return true end
    return type(value) == "number" and value >= minPs
end

F.eggInSelectedZoneFolder = function(egg)
    local zid = F.getEggZoneId(egg)
    if zid then return F.matchesZoneFilter(zid) end
    local p = egg.Parent
    while p and p ~= Workspace do
        for _, z in ipairs(CFG.Zones) do
            if (p.Name == z.Folder or p.Name:find(z.Folder, 1, true) or p.Name:find(z.Name, 1, true))
                and State.zoneFilter[z.Name] then
                return true
            end
        end
        p = p.Parent
    end
    return false
end

F.getNearestEgg = function()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    local best, bestDist = nil, math.huge

    for _, egg in ipairs(CollectionService:GetTagged("BreakableEgg")) do
        if F.isEggLive(egg) then
            local inZone = F.matchesZoneFilter(F.getEggZoneId(egg)) or F.eggInSelectedZoneFolder(egg)
            if inZone and F.matchesEggRarityFilter(F.getEggRarity(egg)) then
                local dist = F.surfaceDistance(egg, myPos)
                if dist < bestDist then
                    best, bestDist = egg, dist
                end
            end
        end
    end
    return best, bestDist
end

--------------------------------------------------
F.getAnimalPivot = function(pickup)
    if not pickup then return nil end
    if pickup:IsA("Model") then return pickup:GetPivot().Position end
    if pickup:IsA("BasePart") then return pickup.Position end
    return nil
end

F.findOverhead = function(model)
    if not model then return nil end
    local att = model:FindFirstChild("AnimalOverheadAttachment", true)
    if att then
        local oh = att:FindFirstChild("AnimalOverhead")
        if oh then return oh end
    end
    for _, child in ipairs(model:GetChildren()) do
        local a2 = child:FindFirstChild("AnimalOverheadAttachment", true)
        if a2 then
            local oh = a2:FindFirstChild("AnimalOverhead")
            if oh then return oh end
        end
    end
    return nil
end

F.getAnimalCashPerSecond = function(animal)
    if not animal then return 0 end
    local attr = animal:GetAttribute("CashPerSecond") or animal:GetAttribute("PerSecond")
    if type(attr) == "number" then return attr end
    local oh = F.findOverhead(animal)
    if oh then
        local folder = oh:FindFirstChild("CashPerSecond")
        if folder then
            local lbl = folder:FindFirstChild("CashPerSecond")
            if lbl and lbl:IsA("TextLabel") then return F.parseCashText(lbl.Text) end
            for _, d in ipairs(folder:GetDescendants()) do
                if d:IsA("TextLabel") then
                    local v = F.parseCashText(d.Text)
                    if v > 0 then return v end
                end
            end
        end
    end
    return 0
end

F.getAnimalRarity = function(animal)
    if not animal then return nil end
    local attr = animal:GetAttribute("Rarity") or animal:GetAttribute("rarity")
    if type(attr) == "string" and attr ~= "" then return attr end
    local oh = F.findOverhead(animal)
    if oh then
        local folder = oh:FindFirstChild("Rarity")
        if folder then
            local lbl = folder:FindFirstChild("RarityLabel") or folder:FindFirstChildWhichIsA("TextLabel")
            if lbl and lbl:IsA("TextLabel") then
                local t = (lbl.Text or ""):match("^%s*(.-)%s*$")
                if t ~= "" then return t end
            end
        end
    end
    return nil
end

F.getAnimalZoneId = function(animal)
    if not animal then return nil end
    local z = animal:GetAttribute("ZoneId")
        or animal:GetAttribute("ZoneID")
        or animal:GetAttribute("Zone")
        or animal:GetAttribute("zoneId")
    if type(z) == "number" then return "Zone" .. tostring(math.floor(z)) end
    if type(z) == "string" and z ~= "" then
        local n = z:match("^(%d+)$")
        if n then return "Zone" .. n end
        return z
    end
    return nil
end

F.animalMatchesFilter = function(pickup)
    if not pickup then return false end
    if not F.matchesZoneFilter(F.getAnimalZoneId(pickup)) then return false end
    local rarity = F.getAnimalRarity(pickup)
    if rarity and not F.matchesRarityFilter(rarity) then return false end
    local cps = F.getAnimalCashPerSecond(pickup)
    if cps > 0 and not F.matchesPerSecondFilter(cps) then return false end
    return true
end

F.getAnyAnimalNear = function(pos, radius)
    radius = radius or 25
    local folder = Workspace:FindFirstChild("AnimalPickups")
    if not folder or not pos then return nil end
    local best, bestDist = nil, radius
    for _, pickup in ipairs(folder:GetChildren()) do
        if pickup.Parent and not pickup:GetAttribute("Despawning") then
            local pivot = F.getAnimalPivot(pickup)
            if pivot then
                local d = (pivot - pos).Magnitude
                if d <= bestDist then
                    best, bestDist = pickup, d
                end
            end
        end
    end
    return best
end

F.getPickupPart = function(pickup)
    if not pickup then return nil end
    if pickup:IsA("BasePart") then return pickup end
    if pickup.PrimaryPart then return pickup.PrimaryPart end
    return pickup:FindFirstChildWhichIsA("BasePart", true)
end

F.getAnchorPos = function(anchor)
    if not anchor then return nil end
    if anchor:IsA("BasePart") then return anchor.Position end
    if anchor:IsA("Model") then
        return (anchor.PrimaryPart and anchor.PrimaryPart.Position) or anchor:GetPivot().Position
    end
    local part = anchor:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

F.getStealPromptNear = function(animalPos, maxDist)
    maxDist = maxDist or 25
    if not animalPos then return nil, nil end
    local bestPrompt, bestAnchor, bestDist = nil, nil, maxDist
    for _, child in ipairs(Workspace:GetChildren()) do
        if child.Name == "PromptAnchor" then
            local apos = F.getAnchorPos(child)
            if apos then
                local d = (apos - animalPos).Magnitude
                if d <= bestDist then
                    local prompt = child:FindFirstChild("StealPrompt")
                    if not (prompt and prompt:IsA("ProximityPrompt")) then
                        prompt = child:FindFirstChildWhichIsA("ProximityPrompt", true)
                    end
                    if prompt and prompt:IsA("ProximityPrompt") then
                        bestPrompt, bestAnchor, bestDist = prompt, child, d
                    end
                end
            end
        end
    end
    return bestPrompt, bestAnchor
end

F.isCarryingAnimal = function()
    local folder = Workspace:FindFirstChild("CarriedAnimals")
    if not folder then return false end
    local myId = LP.UserId
    for _, child in ipairs(folder:GetChildren()) do
        local uid = child:GetAttribute("CarriedUserId")
            or child:GetAttribute("CarrieUserId")
            or child:GetAttribute("CarrierUserId")
            or child:GetAttribute("OwnerUserId")
        if uid == myId or tonumber(uid) == myId then
            return true
        end
    end
    return false
end

F.getMyCarriedAnimal = function()
    local folder = Workspace:FindFirstChild("CarriedAnimals")
    if not folder then return nil end
    local myId = LP.UserId
    for _, child in ipairs(folder:GetChildren()) do
        local uid = child:GetAttribute("CarriedUserId")
            or child:GetAttribute("CarrieUserId")
            or child:GetAttribute("CarrierUserId")
            or child:GetAttribute("OwnerUserId")
        if uid == myId or tonumber(uid) == myId then
            return child
        end
    end
    return nil
end

F.fireStealPromptNear = function(animalPos, allowTP)
    local prompt, anchor = F.getStealPromptNear(animalPos, 25)
    if not prompt or not anchor then return false end
    local tpPos = F.getAnchorPos(anchor)
    if not tpPos then return false end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and allowTP ~= false and (hrp.Position - tpPos).Magnitude > 7 then
        pcall(function()
            hrp.CFrame = CFrame.new(tpPos + Vector3.new(0, 3, 0))
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        task.wait(0.05)
    end
    if fireproximityprompt then
        local ok = pcall(function() fireproximityprompt(prompt) end)
        if ok then return true end
    end
    local ok2 = pcall(function()
        local hold = prompt.HoldDuration or 0
        prompt:InputHoldBegin()
        task.wait(math.max(hold, 0.08) + 0.05)
        prompt:InputHoldEnd()
    end)
    return ok2 == true
end

F.getHitRemote = function()
    local r = ReplicatedStorage:FindFirstChild("EggHitRequest")
    return (r and r:IsA("RemoteEvent")) and r or nil
end

F.hitEggViaRemote = function(egg)
    if not egg or not egg.Parent then return false end
    local r = F.getHitRemote()
    if not r then return false end
    return pcall(function()
        r:FireServer(egg)
    end)
end

F.equipPickaxe = function()
    local char = LP.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    if char:FindFirstChild("Pickaxe") then return char.Pickaxe end
    local bp = LP:FindFirstChild("Backpack")
    local pickaxe = bp and bp:FindFirstChild("Pickaxe")
    if pickaxe and pickaxe:IsA("Tool") then
        pcall(function() hum:EquipTool(pickaxe) end)
        task.wait(0.05)
        return pickaxe
    end
    return nil
end

--------------------------------------------------
F.findBestMatchingAnimal = function(exclude)
    if next(State.zoneFilter) == nil then return nil end
    local folder = Workspace:FindFirstChild("AnimalPickups")
    if not folder then return nil end

    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = hrp and hrp.Position or nil

    local best, bestDist = nil, math.huge
    for _, pickup in ipairs(folder:GetChildren()) do
        if pickup.Parent and not pickup:GetAttribute("Despawning") then
            if not (exclude and exclude[pickup]) then
                if F.animalMatchesFilter(pickup) then
                    local pivot = F.getAnimalPivot(pickup)
                    if pivot then
                        local d = myPos and (pivot - myPos).Magnitude or 0
                        if d < bestDist then
                            best, bestDist = pickup, d
                        end
                    else
                        if not best then best = pickup end
                    end
                end
            end
        end
    end
    return best
end

F.autoFarmEggLoop = function()
    local targetEgg = nil
    local currentAnimal = nil
    local animalDidTP = false
    local animalCollectStart = 0
    local returningToBase = false
    local returnStartTime = 0
    local skipUntil = {}

    while State.autoFarmEgg and not State.isDestroyed do
        local ok, err = pcall(function()
            local char = LP.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            F.equipPickaxe()

            local now = os.clock()
            for a, untilT in pairs(skipUntil) do
                if now >= untilT or not a.Parent then
                    skipUntil[a] = nil
                end
            end

            if returningToBase then
                F.tpToBase()
                task.wait(0.06)
                if F.isAtBase(15) or (os.clock() - returnStartTime > 2) then
                    returningToBase = false
                    currentAnimal = nil
                    animalDidTP = false
                end
                return
            end

            if F.isCarryingAnimal() then
                currentAnimal = nil
                animalDidTP = false
                returningToBase = true
                returnStartTime = os.clock()
                return
            end

            if currentAnimal then
                if not currentAnimal.Parent or currentAnimal:GetAttribute("Despawning") then
                    currentAnimal = nil
                    animalDidTP = false
                    return
                end
                local apart = F.getPickupPart(currentAnimal)
                if not apart then
                    currentAnimal = nil
                    animalDidTP = false
                    return
                end

                F.fireStealPromptNear(apart.Position, not animalDidTP)
                animalDidTP = true
                task.wait(0.15)

                if F.isCarryingAnimal() then
                    currentAnimal = nil
                    animalDidTP = false
                    returningToBase = true
                    returnStartTime = os.clock()
                    return
                end

                if os.clock() - animalCollectStart > 5 then
                    skipUntil[currentAnimal] = os.clock() + 2
                    currentAnimal = nil
                    animalDidTP = false
                end
                return
            end

            do
                local animal = F.findBestMatchingAnimal(skipUntil)
                if animal then
                    currentAnimal = animal
                    animalCollectStart = os.clock()
                    animalDidTP = false
                    return
                end
            end

            if targetEgg and (not targetEgg.Parent or not F.isEggLive(targetEgg)) then
                targetEgg = nil
            end

            if not targetEgg or not targetEgg.Parent or not F.isEggLive(targetEgg) then
                targetEgg = F.getNearestEgg()
                if not targetEgg then
                    task.wait(0.12)
                    return
                end
            end

            local part = F.getEggPart(targetEgg)
            if not part then
                targetEgg = nil
                return
            end
            if (hrp.Position - part.Position).Magnitude > 6 then
                F.tpToPosition(part.Position)
            end
            F.hitEggViaRemote(targetEgg)
        end)
        if not ok and err then
            warn("[Yuta Hub Farm]", tostring(err))
        end
        task.wait(State.autoFarmEggHitInterval)
    end
end

F.startAutoFarmEgg = function()
    if State.autoFarmEgg then return end
    State.autoFarmEgg = true
    State.autoFarmEggLoop = task.spawn(F.autoFarmEggLoop)
end

F.stopAutoFarmEgg = function()
    State.autoFarmEgg = false
    if State.autoFarmEggLoop then
        pcall(task.cancel, State.autoFarmEggLoop)
        State.autoFarmEggLoop = nil
    end
end

--------------------------------------------------
F.findTreadmill = function()
    local base = F.getMyBase()
    if not base then return nil end
    for _, sub in ipairs(base:GetDescendants()) do
        if sub:IsA("Model") and sub:GetAttribute("SpeedMultiplier") ~= nil then
            return sub
        end
    end
    return nil
end

F.getTreadmillPart = function(treadmill)
    if not treadmill then return nil end
    if treadmill.PrimaryPart then return treadmill.PrimaryPart end
    local hitbox = treadmill:FindFirstChild("Hitbox")
    if hitbox and hitbox:IsA("BasePart") then return hitbox end
    return treadmill:FindFirstChildWhichIsA("BasePart", true)
end

F.isOnTreadmill = function()
    local treadmill = F.findTreadmill()
    if not treadmill then return false end
    local part = F.getTreadmillPart(treadmill)
    if not part then return false end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return (hrp.Position - part.Position).Magnitude <= State.onTreadmillDistance
end

F.tpToTreadmill = function(treadmill)
    local target = F.getTreadmillPart(treadmill)
    if not target then return false end
    return F.tpToPosition(target.Position + Vector3.new(0, State.treadmillTpOffset - 3, 0))
end

F.exitTreadmill = function()
    local r = ReplicatedStorage:FindFirstChild("TreadmillSessionRemote")
    if not r or not r:IsA("RemoteEvent") then return false end
    return pcall(function() r:FireServer() end)
end

F.unlockOnce = function()
    local r = ReplicatedStorage:FindFirstChild("UnlockTreadmillRequest")
    if not r or not r:IsA("RemoteEvent") then return false end
    return pcall(function() r:FireServer() end)
end

F.upgradeOnce = function()
    local r = ReplicatedStorage:FindFirstChild("UpgradeTreadmillRequest")
    if not r or not r:IsA("RemoteEvent") then return false end
    return pcall(function() r:FireServer() end)
end

F.startAutoBuy = function()
    if State.autoBuy then return end
    State.autoBuy = true
    task.spawn(function()
        while State.autoBuy and not State.isDestroyed do
            local base = F.getMyBase()
            if base then
                if base:GetAttribute("TreadmillUnlocked") ~= true then
                    if F.getCash() >= CFG.UnlockCost then F.unlockOnce() end
                else
                    local lvl = base:GetAttribute("TreadmillLevel")
                    lvl = type(lvl) == "number" and math.floor(lvl) or 1
                    local cost = CFG.Costs[lvl]
                    if cost and F.getCash() >= cost then F.upgradeOnce() end
                end
            end
            task.wait(0.35)
        end
        State.autoBuy = false
    end)
end

F.stopAutoBuy = function() State.autoBuy = false end

F.getOwnedPickaxes = function()
    local owned = {}
    local s = LP:GetAttribute("OwnedPickaxes")
    if type(s) == "string" then
        for key in string.gmatch(s, "[^,]+") do
            local n = tonumber(key)
            if n then owned[n] = true end
        end
    end
    local tier = LP:GetAttribute("PickaxeTier")
    if type(tier) == "number" then owned[math.floor(tier)] = true end
    owned[1] = true
    return owned
end

F.buyPickaxeTier = function(tier)
    local r = ReplicatedStorage:FindFirstChild("PickaxeShopRequest")
    if not r or not r:IsA("RemoteEvent") then return false end
    return pcall(function()
        r:FireServer("Buy", tier)
    end)
end

F.equipPickaxeTier = function(tier)
    local r = ReplicatedStorage:FindFirstChild("PickaxeShopRequest")
    if not r or not r:IsA("RemoteEvent") then return false end
    return pcall(function()
        r:FireServer("Equip", tier)
    end)
end

F.tryBuyNextPickaxe = function()
    local cash = F.getCash()
    local owned = F.getOwnedPickaxes()
    for _, info in ipairs(CFG.PickaxeTiers) do
        if not owned[info.Tier] and info.Price > 0 and cash >= info.Price then
            F.buyPickaxeTier(info.Tier)
            return true
        end
    end
    return false
end

F.equipBestPickaxe = function()
    local owned = F.getOwnedPickaxes()
    local best = 1
    for tier in pairs(owned) do
        if tier > best then best = tier end
    end
    local cur = LP:GetAttribute("PickaxeTier")
    if type(cur) == "number" and math.floor(cur) == best then return end
    F.equipPickaxeTier(best)
end

F.startAutoBuyPickaxe = function()
    if State.autoBuyPickaxe then return end
    State.autoBuyPickaxe = true
    task.spawn(function()
        while State.autoBuyPickaxe and not State.isDestroyed do
            pcall(function()
                F.tryBuyNextPickaxe()
                F.equipBestPickaxe()
            end)
            task.wait(0.4)
        end
        State.autoBuyPickaxe = false
    end)
end

F.stopAutoBuyPickaxe = function() State.autoBuyPickaxe = false end

F.getPlotLevel = function()
    local base = F.getMyBase()
    if not base then return 1 end
    local lvl = base:GetAttribute("PlotLevel")
        or base:GetAttribute("Level")
        or base:GetAttribute("UpgradeLevel")
        or LP:GetAttribute("PlotLevel")
    if type(lvl) == "number" then return math.floor(lvl) end
    return 1
end

F.upgradePlotOnce = function()
    local names = {
        "PlotUpgradeRequest", "UpgradePlotRequest", "PlotShopRequest",
        "UpgradePlot", "PlotUpgrade",
    }
    local lvl = F.getPlotLevel()
    for _, n in ipairs(names) do
        local r = ReplicatedStorage:FindFirstChild(n)
        if r and r:IsA("RemoteEvent") then
            local ok = pcall(function()
                r:FireServer("Upgrade")
            end)
            if ok then return true end
            ok = pcall(function()
                r:FireServer(lvl)
            end)
            if ok then return true end
            ok = pcall(function()
                r:FireServer()
            end)
            if ok then return true end
        end
    end
    return false
end

F.tryUpgradePlot = function()
    local lvl = F.getPlotLevel()
    if lvl >= CFG.PlotMaxLevel then return false end
    local cost = CFG.PlotCosts[lvl]
    if not cost then return false end
    if F.getCash() < cost then return false end
    return F.upgradePlotOnce()
end

F.startAutoBuyPlot = function()
    if State.autoBuyPlot then return end
    State.autoBuyPlot = true
    task.spawn(function()
        while State.autoBuyPlot and not State.isDestroyed do
            pcall(F.tryUpgradePlot)
            task.wait(0.5)
        end
        State.autoBuyPlot = false
    end)
end

F.stopAutoBuyPlot = function() State.autoBuyPlot = false end

F.getOwnedTrails = function()
    local owned = {}
    local s = LP:GetAttribute(CFG.TrailOwnedAttr)
    if type(s) == "string" then
        for key in string.gmatch(s, "[^,]+") do
            local n = tonumber(key)
            if n then owned[n] = true end
        end
    end
    local eq = LP:GetAttribute(CFG.TrailEquippedAttr)
    if type(eq) == "number" and eq > 0 then owned[math.floor(eq)] = true end
    return owned
end

F.buyTrail = function(id)
    local r = ReplicatedStorage:FindFirstChild("TrailShopRequest")
    if not r or not r:IsA("RemoteEvent") then return false end
    return pcall(function()
        r:FireServer("Buy", id)
    end)
end

F.equipTrail = function(id)
    local r = ReplicatedStorage:FindFirstChild("TrailShopRequest")
    if not r or not r:IsA("RemoteEvent") then return false end
    return pcall(function()
        r:FireServer("Equip", id)
    end)
end

F.tryBuyNextTrail = function()
    local cash = F.getCash()
    local owned = F.getOwnedTrails()
    for _, t in ipairs(CFG.Trails) do
        if not owned[t.Id] and cash >= t.Price then
            F.buyTrail(t.Id)
            return true
        end
    end
    return false
end

F.equipBestTrail = function()
    local owned = F.getOwnedTrails()
    local best = 0
    for id in pairs(owned) do
        if id > best then best = id end
    end
    if best <= 0 then return end
    local eq = LP:GetAttribute(CFG.TrailEquippedAttr)
    if type(eq) == "number" and math.floor(eq) == best then return end
    F.equipTrail(best)
end

F.startAutoBuyTrail = function()
    if State.autoBuyTrail then return end
    State.autoBuyTrail = true
    task.spawn(function()
        while State.autoBuyTrail and not State.isDestroyed do
            pcall(function()
                F.tryBuyNextTrail()
                F.equipBestTrail()
            end)
            task.wait(0.4)
        end
        State.autoBuyTrail = false
    end)
end

F.stopAutoBuyTrail = function() State.autoBuyTrail = false end

F.equipBestPets = function()
    local r = ReplicatedStorage:FindFirstChild("PetsInventoryRemote")
    if not r then return false end
    return pcall(function()
        r:FireServer("EquipBest", nil)
    end)
end

F.startAutoEquipBest = function()
    if State.autoEquipBest then return end
    State.autoEquipBest = true
    State.autoEquipBestLoop = task.spawn(function()
        while State.autoEquipBest and not State.isDestroyed do
            pcall(F.equipBestPets)
            task.wait(State.autoEquipBestInterval)
        end
        State.autoEquipBest = false
    end)
end

F.stopAutoEquipBest = function()
    State.autoEquipBest = false
    if State.autoEquipBestLoop then
        pcall(task.cancel, State.autoEquipBestLoop)
        State.autoEquipBestLoop = nil
    end
end

F.autoTreadmillLoop = function()
    while State.autoTreadmill and not State.isDestroyed do
        pcall(function()
            if not F.isOnTreadmill() then
                local t = F.findTreadmill()
                if t then F.tpToTreadmill(t) end
            end
        end)
        task.wait(0.4)
    end
end

F.startAutoTreadmill = function()
    if State.autoTreadmill then return end
    State.autoTreadmill = true
    State.autoTreadmillLoop = task.spawn(F.autoTreadmillLoop)
end

F.stopAutoTreadmill = function()
    State.autoTreadmill = false
    if State.autoTreadmillLoop then
        pcall(task.cancel, State.autoTreadmillLoop)
        State.autoTreadmillLoop = nil
    end
    F.exitTreadmill()
end

F.applyAntiLag = function()
    pcall(function()
        local T = Workspace:FindFirstChildWhichIsA("Terrain")
        if T then
            T.WaterWaveSize = 0
            T.WaterWaveSpeed = 0
            T.WaterReflectance = 0
            T.WaterTransparency = 1
        end
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        pcall(function() settings().Rendering.QualityLevel = 1 end)
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("BasePart") then
                pcall(function()
                    v.CastShadow = false
                    v.Material = Enum.Material.Plastic
                    v.Reflectance = 0
                end)
            elseif v:IsA("Decal") then
                pcall(function() v.Transparency = 1 end)
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                pcall(function() v.Lifetime = NumberRange.new(0) end)
            end
        end
    end)
end

function F.safeNotify(desc, title, time)
    pcall(function()
        chloex(tostring(desc), time or 3, nil, title or "Yuta Hub", "")
    end)
end

